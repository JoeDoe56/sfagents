{
  "name": "sfagents-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "SF Agents: JSON-defined agent runtime and CLI",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "core",
    "web",
    "cli"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "prepare": "node scripts/build-sensors.mjs && tsc -b web cli tests",
    "build": "node scripts/build-sensors.mjs && tsc -b web cli tests",
    "build:sensors": "node scripts/build-sensors.mjs",
    "sensors:setup": "powershell.exe -NoProfile -File scripts/setup-sensors.ps1",
    "clean": "tsc -b web cli tests --clean",
    "typecheck": "tsc -b web cli tests",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:live": "npm run build && node scripts/run-tests.mjs --live",
    "audit:imports": "node scripts/audit-imports.mjs",
    "sfagents": "node cli/dist/index.js",
    "vendor:sfgl": "node scripts/vendor-sfgl.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "typescript": "~5.9.3"
  }
}

diff --git a/frontend/test/Embed.test.js b/frontend/test/Embed.test.js
new file mode 100644
index 0000000..d49d152
--- /dev/null
+++ b/frontend/test/Embed.test.js
@@ -0,0 +1,32 @@
+import { describe, it, expect } from 'vitest';
+import { embedPixelSize, EMBED } from '../js/embed.js';
+
+describe('embedded in SF Agents', () => {
+    it('is off in a page that is not framed', () => {
+        expect(EMBED).toBe(false);
+    });
+
+    it('fits the frame to 16:9 in physical pixels', () => {
+        expect(embedPixelSize({ innerWidth: 1280, innerHeight: 800, devicePixelRatio: 1 }, 1)).toEqual({ width: 1280, height: 720 });
+        expect(embedPixelSize({ innerWidth: 1440, innerHeight: 1200, devicePixelRatio: 2 }, 1)).toEqual({ width: 2880, height: 1620 });
+    });
+
+    it('turns with the frame: 9:16 when it is taller than wide', () => {
+        expect(embedPixelSize({ innerWidth: 390, innerHeight: 760, devicePixelRatio: 3 }, 1)).toEqual({ width: 1170, height: 2080 });
+    });
+
+    it('keeps both sides even and within 640 to 3840', () => {
+        const big = embedPixelSize({ innerWidth: 5000, innerHeight: 3000, devicePixelRatio: 2 }, 1);
+        expect(big).toEqual({ width: 3840, height: 2160 });
+        const small = embedPixelSize({ innerWidth: 200, innerHeight: 100, devicePixelRatio: 1 }, 1);
+        expect(small).toEqual({ width: 640, height: 360 });
+        const odd = embedPixelSize({ innerWidth: 1001, innerHeight: 999, devicePixelRatio: 1.5 }, 1);
+        expect(odd.width % 2).toBe(0);
+        expect(odd.height % 2).toBe(0);
+        expect(odd.width / odd.height).toBeCloseTo(16 / 9, 5);
+    });
+
+    it('scales the stream down when asked', () => {
+        expect(embedPixelSize({ innerWidth: 1280, innerHeight: 720, devicePixelRatio: 2 }, 0.5)).toEqual({ width: 1280, height: 720 });
+    });
+});

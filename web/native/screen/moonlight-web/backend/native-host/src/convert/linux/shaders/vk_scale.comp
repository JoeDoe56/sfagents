#version 450
// VulkanConvert's resample pass: Lanczos-2 dilated to the ratio, separable, in
// linear light. GlConvert's kScaleBody transcribed line for line (see there, and
// ColorConvert.cpp, for the why: the bench of 17/09/2026), so that both routes
// scale a picture to the same pixels; what GL has as #defines per geometry
// comes in as push constants, what it has per direction is built twice, with
// MW_HORIZONTAL at 1 and at 0 (CMakeLists.txt).
//
// Horizontal: the scanout, decoded to linear light per tap, into the
// picture-wide, source-high intermediate (RGBA16F). Vertical: the intermediate
// into the output-sized picture, encoded back to sRGB once per pixel into a
// plain RGBA8 the conversion then samples as it would the scanout; outside the
// picture's rectangle — a letterboxed source — black bars.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D Source;
#if MW_HORIZONTAL
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D Target;
#else
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D Target;
#endif

layout(push_constant) uniform Push
{
    ivec2 origin;   // the picture's corner in the target (0,0 horizontally)
    ivec2 size;     // the picture: the viewport GL draws it through
    ivec2 extent;   // the whole target, bars included
    ivec2 offset;   // where the picture starts in the input: a screen's window
                    // of an X11 root horizontally (KmsFrame::sourceX), 0,0 after
    float len;      // MW_LEN: the length resampled along
    float fixedLen; // MW_FIXED: the other dimension of the input
    float dilate;   // MW_DILATE: max(1, len / output)
    int taps;       // MW_TAPS: ceil(4 * dilate) + 1
} pc;

vec3 srgbToLinear(vec3 c)
{
    return mix(c / 12.92, pow(max(c + 0.055, 0.0) / 1.055, vec3(2.4)), step(0.04045, c));
}
vec3 linearToSrgb(vec3 c)
{
    c = max(c, 0.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}
// Lanczos with two lobes, x already divided by the dilation.
float lanczos2(float x)
{
    x = abs(x);
    if (x < 1e-5) return 1.0;
    if (x >= 2.0) return 0.0;
    float px = 3.14159265 * x;
    return 2.0 * sin(px) * sin(px * 0.5) / (px * px);
}
vec3 fetch(int x, int y)
{
    vec3 c = texelFetch(Source, ivec2(x, y) + pc.offset, 0).rgb;
#if MW_HORIZONTAL
    c = srgbToLinear(c);
#endif
    return c;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.extent.x || p.y >= pc.extent.y) return;
    ivec2 q = p - pc.origin;
    if (q.x < 0 || q.y < 0 || q.x >= pc.size.x || q.y >= pc.size.y) {
        // The bars: GL clears the target black before drawing the picture.
        imageStore(Target, p, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    // Where GL's fragment samples its full-screen triangle's uv.
    vec2 uv = (vec2(q) + 0.5) / vec2(pc.size);
#if MW_HORIZONTAL
    float centre = uv.x * pc.len - 0.5;
    int fixedCoord = int(uv.y * pc.fixedLen);
#else
    float centre = uv.y * pc.len - 0.5;
    int fixedCoord = int(uv.x * pc.fixedLen);
#endif
    int first = int(ceil(centre - 2.0 * pc.dilate));
    vec3 acc = vec3(0.0);
    float sum = 0.0;
    for (int t = 0; t < pc.taps; ++t) {
        int s = first + t;
        float w = lanczos2((float(s) - centre) / pc.dilate);
        s = clamp(s, 0, int(pc.len) - 1);
#if MW_HORIZONTAL
        acc += fetch(s, fixedCoord) * w;
#else
        acc += fetch(fixedCoord, s) * w;
#endif
        sum += w;
    }
    vec3 c = max(acc / sum, 0.0);
#if MW_HORIZONTAL
    imageStore(Target, p, vec4(c, 1.0));
#else
    imageStore(Target, p, vec4(linearToSrgb(c), 1.0));
#endif
}

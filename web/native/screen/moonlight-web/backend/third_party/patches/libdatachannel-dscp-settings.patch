+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+
+#ifndef RTC_IMPL_DSCP_H
+#define RTC_IMPL_DSCP_H
+
+#include <atomic>
+
+namespace rtc::impl::dscp {
+
+// The DSCP of outgoing packets, process-wide (rtc::SetDscpSettings). -1 is
+// not set: the RFC 8837 values below.
+inline std::atomic<int> &audioValue() {
+	static std::atomic<int> v{-1};
+	return v;
+}
+inline std::atomic<int> &videoValue() {
+	static std::atomic<int> v{-1};
+	return v;
+}
+inline std::atomic<int> &dataValue() {
+	static std::atomic<int> v{-1};
+	return v;
+}
+
+// See https://www.rfc-editor.org/rfc/rfc8837.html#section-5
+inline unsigned int audio() {
+	const int v = audioValue().load(std::memory_order_relaxed);
+	return v >= 0 ? unsigned(v) : 46; // EF: Expedited Forwarding
+}
+inline unsigned int video() {
+	const int v = videoValue().load(std::memory_order_relaxed);
+	return v >= 0 ? unsigned(v) : 36; // AF42: Assured Forwarding class 4, medium drop probability
+}
+inline unsigned int data() {
+	const int v = dataValue().load(std::memory_order_relaxed);
+	return v >= 0 ? unsigned(v) : 10; // AF11: Assured Forwarding class 1, low drop probability
+}
+
+} // namespace rtc::impl::dscp
+
+#endif

 #include "impl/init.hpp"
 
 #include <mutex>
@@ -86,6 +87,15 @@ void InitLogger(plog::Severity severity, plog::IAppender *appender) {
 void SetThreadPoolSize(unsigned int count) { impl::Init::Instance().setThreadPoolSize(count); }
 void SetSctpSettings(SctpSettings s) { impl::Init::Instance().setSctpSettings(std::move(s)); }
 
+void SetDscpSettings(DscpSettings s) {
+	const auto store = [](std::atomic<int> &to, const optional<unsigned int> &v) {
+		to.store(v ? int(*v & 0x3F) : -1, std::memory_order_relaxed);
+	};
+	store(impl::dscp::audioValue(), s.audio);
+	store(impl::dscp::videoValue(), s.video);
+	store(impl::dscp::dataValue(), s.data);
+}
+
 void Preload() { impl::Init::Instance().preload(); }
 std::shared_future<void> Cleanup() { return impl::Init::Instance().cleanup(); }
 
diff --git a/src/impl/dscp.hpp b/src/impl/dscp.hpp
new file mode 100644
index 00000000..f655b621
--- /dev/null
+++ b/src/impl/dscp.hpp
@@ -0,0 +1,47 @@
+/**

--- a/include/rtc/global.hpp
+++ b/include/rtc/global.hpp
@@ -51,6 +51,16 @@ struct SctpSettings {
 
 RTC_CPP_EXPORT void SetSctpSettings(SctpSettings s);
 
+// DSCP (6 bits, 0-63) of outgoing packets, process-wide. Not set means the
+// RFC 8837 defaults: EF for audio tracks, AF42 for other media, AF11 for SCTP.
+struct DscpSettings {
+	optional<unsigned int> audio; // audio tracks
+	optional<unsigned int> video; // other media tracks
+	optional<unsigned int> data;  // SCTP (data channels)
+};
+
+RTC_CPP_EXPORT void SetDscpSettings(DscpSettings s);
+
 // Optional global preload and cleanup
 RTC_CPP_EXPORT void Preload();
 RTC_CPP_EXPORT std::shared_future<void> Cleanup();

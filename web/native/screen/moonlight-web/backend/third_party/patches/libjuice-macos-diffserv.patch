-			addr_map_inet6_v4mapped(&tmp.addr, &tmp.len);
+		if (name.addr.ss_family == AF_INET6 && addr_map_inet6_v4mapped(&tmp.addr, &tmp.len)) {
+#ifdef __APPLE__

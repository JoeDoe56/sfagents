+			socklen_t optlen = sizeof(tclass);
+			if (getsockopt(sock, IPPROTO_IPV6, IPV6_TCLASS, &tclass, &optlen) == 0 && tclass > 0)
+				return udp_sendto_tclass(sock, data, size, &tmp, tclass);
+#endif

{
  "name": "@sfagents/web",
  "version": "0.1.0",
  "description": "SF Agents web interface: HTTP server and browser client",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "native/bin",
    "native/windows/*.cs",
    "native/windows/*.csproj",
    "native/windows/NuGet.Config",
    "native/windows/packages.lock.json",
    "native/windows-input/*.cs",
    "native/windows-input/*.csproj",
    "sounds",
    "native/linux",
    "native/NOTICE.md",
    "native/licenses"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@sfagents/core": "0.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "clipboardy": "5.3.2"
  },
  "optionalDependencies": {
    "@picovoice/pvrecorder-node": "1.2.9",
    "@picovoice/pvspeaker-node": "1.0.3",
    "node-pty": "1.1.0",
    "uiohook-napi": "1.5.5"
  }
}
